<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Turbo Road Racer</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    background:#080808;
    color:white;
    font-family:Arial,sans-serif;
    text-align:center;
    overflow:hidden;
}

h1{
    margin:15px 0 5px;
    font-size:32px;
}

.info{
    display:flex;
    justify-content:center;
    gap:35px;
    margin:10px;
    font-size:18px;
}

.game{
    position:relative;
    width:400px;
    height:650px;
    max-width:95vw;
    margin:auto;
    overflow:hidden;
    background:#333;
    border-left:7px solid #777;
    border-right:7px solid #777;
}

/* ROAD */

.road{
    position:absolute;
    width:100%;
    height:100%;
    background:#292929;
}

.line{
    position:absolute;
    width:8px;
    height:90px;
    background:white;
    left:50%;
    transform:translateX(-50%);
    box-shadow:0 140px white,0 280px white,0 420px white,
               0 560px white;
    top:-100px;
}

.roadLine2{
    position:absolute;
    width:8px;
    height:90px;
    background:white;
    left:33%;
    opacity:.8;
}

.roadLine3{
    position:absolute;
    width:8px;
    height:90px;
    background:white;
    left:66%;
    opacity:.8;
}

/* PLAYER */

.car{
    position:absolute;
    width:55px;
    height:95px;
    bottom:35px;
    left:172px;
    background:#e63946;
    border-radius:14px 14px 8px 8px;
    box-shadow:0 0 20px rgba(255,50,50,.5);
    z-index:5;
}

.car:before{
    content:"";
    position:absolute;
    width:38px;
    height:35px;
    background:#80d8ff;
    left:8px;
    top:13px;
    border-radius:8px;
}

.car:after{
    content:"";
    position:absolute;
    width:43px;
    height:8px;
    background:#222;
    left:6px;
    bottom:18px;
    border-radius:5px;
}

.wheel{
    position:absolute;
    width:9px;
    height:25px;
    background:#111;
    border-radius:5px;
}

.w1{left:-7px;top:18px}
.w2{right:-7px;top:18px}
.w3{left:-7px;bottom:18px}
.w4{right:-7px;bottom:18px}

/* ENEMY */

.enemy{
    position:absolute;
    width:55px;
    height:95px;
    background:#3978ff;
    border-radius:14px 14px 8px 8px;
    top:-120px;
    z-index:4;
}

.enemy:before{
    content:"";
    position:absolute;
    width:38px;
    height:35px;
    background:#222;
    left:8px;
    top:13px;
    border-radius:8px;
}

/* COIN */

.coin{
    position:absolute;
    width:30px;
    height:30px;
    border-radius:50%;
    background:gold;
    color:#9a6500;
    font-weight:bold;
    line-height:30px;
    top:-50px;
    z-index:3;
}

/* GAME OVER */

.gameOver{
    position:absolute;
    inset:0;
    background:rgba(0,0,0,.82);
    display:none;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    z-index:20;
}

.gameOver h2{
    font-size:45px;
    color:#ff4b4b;
    margin-bottom:15px;
}

.gameOver p{
    font-size:20px;
    margin-bottom:25px;
}

button{
    border:none;
    padding:14px 28px;
    border-radius:25px;
    background:#ff3b3b;
    color:white;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
}

button:hover{
    transform:scale(1.06);
}

.controls{
    margin-top:12px;
    color:#aaa;
}

@media(max-height:750px){
    .game{
        height:570px;
    }
}
</style>
</head>

<body>

<h1>🏎️ TURBO ROAD RACER</h1>

<div class="info">
    <div>Score: <b id="score">0</b></div>
    <div>Speed: <b id="speed">1</b></div>
</div>

<div class="game" id="game">

    <div class="road"></div>

    <div class="line" id="roadLine"></div>

    <div class="car" id="player">
        <div class="wheel w1"></div>
        <div class="wheel w2"></div>
        <div class="wheel w3"></div>
        <div class="wheel w4"></div>
    </div>

    <div class="enemy" id="enemy"></div>

    <div class="coin" id="coin">$</div>

    <div class="gameOver" id="gameOver">

        <h2>GAME OVER</h2>

        <p>Your Score: <b id="finalScore">0</b></p>

        <button onclick="restartGame()">
            PLAY AGAIN
        </button>

    </div>

</div>

<div class="controls">
    ⬅️ LEFT &nbsp;&nbsp; | &nbsp;&nbsp; RIGHT ➡️
    <br>
    <small>Use keyboard arrow keys</small>
</div>


<script>

const game = document.getElementById("game");
const player = document.getElementById("player");
const enemy = document.getElementById("enemy");
const coin = document.getElementById("coin");
const roadLine = document.getElementById("roadLine");

const scoreText = document.getElementById("score");
const speedText = document.getElementById("speed");

const gameOverScreen = document.getElementById("gameOver");
const finalScore = document.getElementById("finalScore");

let playerX = 172;
let enemyY = -120;
let coinY = -50;

let score = 0;
let speed = 5;

let gameRunning = true;

let enemyX;
let coinX;

function randomPosition(){

    return Math.floor(
        Math.random() * (game.clientWidth - 70)
    );

}

function resetEnemy(){

    enemyY = -120;
    enemyX = randomPosition();

    enemy.style.left = enemyX + "px";

}

function resetCoin(){

    coinY = -50;
    coinX = randomPosition();

    coin.style.left = coinX + "px";

}

resetEnemy();
resetCoin();


document.addEventListener("keydown", function(e){

    if(!gameRunning) return;

    if(e.key === "ArrowLeft"){

        playerX -= 25;

    }

    if(e.key === "ArrowRight"){

        playerX += 25;

    }

    if(playerX < 5){
        playerX = 5;
    }

    if(playerX > game.clientWidth - 60){
        playerX = game.clientWidth - 60;
    }

    player.style.left = playerX + "px";

});


function collision(a,b){

    const r1 = a.getBoundingClientRect();
    const r2 = b.getBoundingClientRect();

    return !(
        r1.bottom < r2.top ||
        r1.top > r2.bottom ||
        r1.right < r2.left ||
        r1.left > r2.right
    );

}


function gameLoop(){

    if(!gameRunning) return;

    /* ROAD MOVEMENT */

    let currentTop =
        parseInt(roadLine.style.top || "-100");

    currentTop += speed;

    if(currentTop > 50){
        currentTop = -100;
    }

    roadLine.style.top = currentTop + "px";


    /* ENEMY */

    enemyY += speed;

    enemy.style.top = enemyY + "px";

    if(enemyY > game.clientHeight){

        resetEnemy();

        score += 10;

    }


    /* COIN */

    coinY += speed;

    coin.style.top = coinY + "px";

    if(coinY > game.clientHeight){

        resetCoin();

    }


    /* COLLISION */

    if(collision(player,enemy)){

        endGame();
        return;

    }


    /* COIN COLLECTION */

    if(collision(player,coin)){

        score += 50;

        resetCoin();

    }


    /* SCORE */

    score += 0.02;

    scoreText.textContent =
        Math.floor(score);


    /* SPEED */

    if(score > 100){
        speed = 6;
    }

    if(score > 250){
        speed = 7;
    }

    if(score > 500){
        speed = 9;
    }

    if(score > 800){
        speed = 11;
    }

    speedText.textContent = speed - 4;


    requestAnimationFrame(gameLoop);

}


function endGame(){

    gameRunning = false;

    finalScore.textContent =
        Math.floor(score);

    gameOverScreen.style.display =
        "flex";

}


function restartGame(){

    score = 0;
    speed = 5;

    playerX = 172;

    player.style.left =
        playerX + "px";

    gameOverScreen.style.display =
        "none";

    gameRunning = true;

    resetEnemy();
    resetCoin();

    gameLoop();

}


gameLoop();

</script>

</body>
</html>v
